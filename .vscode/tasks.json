{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Log Idea",
      "type": "shell",
      "command": "python scripts/quick_log.py --type idea \"${input:ideaText}\"",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Log Fix",
      "type": "shell",
      "command": "python scripts/quick_log.py --type fix \"${input:fixText}\"",
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "ideaText",
      "type": "promptString",
      "description": "💡 What is your idea or improvement?"
    },
    {
      "id": "fixText",
      "type": "promptString",
      "description": "🛠️ What bug or tweak needs fixing?"
    }
  ]
}
